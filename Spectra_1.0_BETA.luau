function themeManager:ReloadCustomThemes()
    local reloadCustomThemesSettingsPath = themeManagerGetCurrentThemesPath()
    if reloadCustomThemesSettingsPath == false then
        return {}
    end

    pcall(makefolder, reloadCustomThemesSettingsPath)
    local reloadCustomThemesSuccessList, reloadCustomThemesFiles = pcall(themeManagerListfiles, reloadCustomThemesSettingsPath)
    if not (reloadCustomThemesSuccessList and typeof(reloadCustomThemesFiles) == "table") then
        themeManager.Library:Notify(string.format("Failed to load theme list: %s", tostring(reloadCustomThemesFiles)))
        return {}
    end

    local reloadCustomThemesFileNames = {}
    for _reloadCustomThemesUnused1, reloadCustomThemesFilePath in reloadCustomThemesFiles do
        local reloadCustomThemesRawFileName = reloadCustomThemesFilePath:match("(.+)%..+$")
        if not reloadCustomThemesRawFileName then continue end

        local reloadCustomThemesPosition = reloadCustomThemesRawFileName:gsub("\\", "/"):find("/[^/]*$")
        local reloadCustomThemesFileName = reloadCustomThemesPosition and reloadCustomThemesRawFileName:sub(reloadCustomThemesPosition + 1) or reloadCustomThemesRawFileName
        if not reloadCustomThemesFileName or reloadCustomThemesFileName == "default" then continue end

        table.insert(reloadCustomThemesFileNames, reloadCustomThemesFileName)
    end

    return reloadCustomThemesFileNames
end

