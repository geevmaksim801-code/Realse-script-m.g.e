        keybindMenu = if saveJSONLibrary.KeybindFrame then {
            visible = saveJSONLibrary.KeybindFrame.Visible,
            position = saveManagerSpecialValueParser.UDim2.Encode(saveJSONLibrary.KeybindFrame.Position)
        } else nil
    }

    for saveJSONIndex, saveJSONToggle in saveJSONLibrary.Toggles do
        if not saveJSONToggle.Type then continue end
        if saveJSONIgnoreIndexes[saveJSONIndex] then continue end

        local saveJSONParser = saveManagerElementParser[saveJSONToggle.Type]
        if not saveJSONParser then continue end

        table.insert(saveJSONCurrentData.objects, saveJSONParser.Save(saveJSONIndex, saveJSONToggle))
    end

    for saveJSONIndex, saveJSONOption in saveJSONLibrary.Options do
        if not saveJSONOption.Type then continue end
        if saveJSONIgnoreIndexes[saveJSONIndex] then continue end

        local saveJSONParser = saveManagerElementParser[saveJSONOption.Type]
        if not saveJSONParser then continue end

        table.insert(saveJSONCurrentData.objects, saveJSONParser.Save(saveJSONIndex, saveJSONOption))
    end

    for saveJSONTabIndex, saveJSONTab in saveJSONLibrary.Tabs do
        if saveJSONTab.Groupboxes then
            for saveJSONIndex, saveJSONGroupbox in saveJSONTab.Groupboxes do
                if typeof(saveJSONIndex) ~= "string" or saveJSONIgnoreIndexes[saveJSONIndex] then continue end

                local saveJSONParser = saveManagerElementParser.Groupbox
                if not saveJSONParser then continue end

                table.insert(saveJSONCurrentData.objects, saveJSONParser.Save(saveJSONIndex, saveJSONGroupbox, saveJSONTabIndex))
            end
        end

        if saveJSONTab.Tabboxes then
            for saveJSONIndex, saveJSONTabbox in saveJSONTab.Tabboxes do
                if typeof(saveJSONIndex) ~= "string" or saveJSONIgnoreIndexes[saveJSONIndex] then continue end

                local saveJSONParser = saveManagerElementParser.Tabbox
                if not saveJSONParser then continue end

                table.insert(saveJSONCurrentData.objects, saveJSONParser.Save(saveJSONIndex, saveJSONTabbox, saveJSONTabIndex))
            end
        end
    end

    local saveJSONSuccessEncode, saveJSONEncodedData = pcall(saveManagerHttpService.JSONEncode, saveManagerHttpService, saveJSONCurrentData)
    if not saveJSONSuccessEncode then
        return "", false, "Failed to encode data"
    end

    return saveJSONEncodedData, true
end

function saveManager:Save(saveConfigName: string): (boolean, string?)
    if saveManagerIsStringEmpty(saveConfigName) then
        return false, "Invalid config name provided"
    end

    if string.lower(saveConfigName) == "autoload" then
        return false, "Invalid config name provided"
    end

    local saveConfigPath = saveManagerGetConfigPath(saveConfigName)
    if saveConfigPath == false then
        return false, "Invalid config name provided"
    end

    saveManager:CheckFolderTree()

    local saveEncodedData, saveSuccessEncode, saveEncodeErrorMessage = saveManager:SaveJSON(saveConfigName)
    if not saveSuccessEncode then
        return false, saveEncodeErrorMessage
    end

    local saveSuccessWrite, saveErrorMessage = pcall(writefile, saveConfigPath, saveEncodedData)
    if not saveSuccessWrite then
        return false, "Failed to write config file: " .. tostring(saveErrorMessage)
    end

    return true
end

function saveManager:LoadJSON(loadJSONContent: string)
    if saveManagerIsStringEmpty(loadJSONContent) then
        return false, "No JSON provided"
    end

    local loadJSONSuccessDecode, loadJSONDecoded = pcall(saveManagerHttpService.JSONDecode, saveManagerHttpService, loadJSONContent)
    if not loadJSONSuccessDecode or typeof(loadJSONDecoded) ~= "table" or typeof(loadJSONDecoded.objects) ~= "table" then
        return false, "Failed to decode config data"
    end

    local loadJSONLibrary = saveManager.Library
    local loadJSONLoadingOrder = saveManager.LoadingOrder
    local loadJSONIgnoreIndexes = saveManager.Ignore

    if saveManager.UseLoadingOrder == true and typeof(loadJSONLoadingOrder) == "table" then
        table.sort(loadJSONDecoded.objects, function(sortA, sortB)
            local sortAIndex = table.find(loadJSONLoadingOrder, sortA.type) or math.huge
            local sortBIndex = table.find(loadJSONLoadingOrder, sortB.type) or math.huge
            return sortAIndex < sortBIndex
        end)
    end

    if loadJSONLibrary.KeybindFrame and typeof(loadJSONDecoded.keybindMenu) == "table" then
        local loadJSONKeybindFrameData = loadJSONDecoded.keybindMenu
        local loadJSONIsVisible = loadJSONKeybindFrameData.visible == true
        local loadJSONPosition = saveManagerSpecialValueParser.UDim2.Decode(loadJSONKeybindFrameData.position)

        loadJSONLibrary.KeybindFrame.Visible = loadJSONIsVisible
        loadJSONLibrary.KeybindFrame.Position = loadJSONPosition or loadJSONLibrary.KeybindFrame.Position
        
        local loadJSONKeybindMenuToggle = loadJSONLibrary.Options and loadJSONLibrary.Options.KeybindMenuOpen
        if loadJSONKeybindMenuToggle then
            loadJSONKeybindMenuToggle:SetValue(loadJSONIsVisible)
        end
    end

    for _loadJSONUnused1, loadJSONOption in loadJSONDecoded.objects do
        if not loadJSONOption.type then continue end
        if loadJSONIgnoreIndexes[loadJSONOption.idx] then continue end

        local loadJSONParser = saveManagerElementParser[loadJSONOption.type]
        if not loadJSONParser then continue end

        task.defer(loadJSONParser.Load, loadJSONOption.idx, loadJSONOption)
    end

    return true
end

function saveManager:Load(loadConfigName: string): (boolean, string?)
    if saveManagerIsStringEmpty(loadConfigName) then
        return false, "No config is selected"
    end

    local loadConfigPath = saveManagerGetConfigPath(loadConfigName)
    if loadConfigPath == false or not saveManagerIsfile(loadConfigPath) then
        return false, "Config file does not exist"
    end

    local loadSuccessRead, loadContent = pcall(readfile, loadConfigPath)
    if not loadSuccessRead then
        return false, "Failed to read config file"
    end

    return saveManager:LoadJSON(loadContent)
end

function saveManager:Delete(deleteConfigName: string): (boolean | string?)
    if saveManagerIsStringEmpty(deleteConfigName) then
        return false, "No config is selected"
    end

    local deleteConfigPath = saveManagerGetConfigPath(deleteConfigName)
    if deleteConfigPath == false or not saveManagerIsfile(deleteConfigPath) then
        return false, "Config file does not exist"
    end

    local deleteSuccessDelete, deleteErrorMessage = pcall(delfile, deleteConfigPath)
    if not deleteSuccessDelete then
        return false, "Failed to delete config file: " .. tostring(deleteErrorMessage)
    end

    if deleteConfigName == saveManager.AutoloadConfig then
        saveManager:DeleteAutoLoadConfig()
    end

    return true
end

function saveManager:GetAutoloadConfig(): (string, boolean, string?)
    saveManager:CheckFolderTree()

    local getAutoloadConfigAutoloadPath = saveManagerGetAutoloadPath()
    if getAutoloadConfigAutoloadPath == false then
        return "none", false, "Invalid path provided"
    end

    if not saveManagerIsfile(getAutoloadConfigAutoloadPath) then
        return "none", false, "Autoload config is not set"
    end

    local getAutoloadConfigSuccessRead, getAutoloadConfigAutoloadConfigName = pcall(readfile, getAutoloadConfigAutoloadPath)
    if not (getAutoloadConfigSuccessRead and typeof(getAutoloadConfigAutoloadConfigName) == "string") then
        return "none", false, getAutoloadConfigAutoloadConfigName
    end

    local getAutoloadConfigConfigExists = saveManagerDoesConfigExist(getAutoloadConfigAutoloadConfigName)
    if not getAutoloadConfigConfigExists then
        return "none", false, "Config file not found"
    end

    saveManager.AutoloadConfig = getAutoloadConfigAutoloadConfigName
    return getAutoloadConfigAutoloadConfigName, true
end

function saveManager:SaveAutoloadConfig(saveAutoloadConfigConfigName: string): (boolean, string?)
    if saveManagerIsStringEmpty(saveAutoloadConfigConfigName) then
        return false, "No config is selected"
    end

    saveManager:CheckFolderTree()

    local saveAutoloadConfigAutoloadPath = saveManagerGetAutoloadPath()
    if saveAutoloadConfigAutoloadPath == false then
        return false, "Invalid path provided"
    end

    if not saveManagerDoesConfigExist(saveAutoloadConfigConfigName) then
        return false, "Config does not exist"
    end

    local saveAutoloadConfigSuccessWrite, saveAutoloadConfigErrorMessage = pcall(writefile, saveAutoloadConfigAutoloadPath, saveAutoloadConfigConfigName)
    if not saveAutoloadConfigSuccessWrite then
        return false, saveAutoloadConfigErrorMessage
    end

    saveManager.AutoloadConfig = saveAutoloadConfigConfigName
    return true
end

function saveManager:LoadAutoloadConfig()
    local loadAutoloadConfigConfigName, loadAutoloadConfigSuccess, loadAutoloadConfigFetchErrorMessage = saveManager:GetAutoloadConfig()
    if not loadAutoloadConfigSuccess or loadAutoloadConfigFetchErrorMessage then
        if loadAutoloadConfigFetchErrorMessage ~= "Autoload config is not set" then
            saveManager.Library:Notify(string.format("Failed to load autoload config: %s", loadAutoloadConfigFetchErrorMessage))
        end

        return
    end

    local loadAutoloadConfigSuccessLoad, loadAutoloadConfigLoadErrorMessage = saveManager:Load(loadAutoloadConfigConfigName)
    if not loadAutoloadConfigSuccessLoad then
        saveManager.Library:Notify(string.format("Failed to load autoload config: %s", loadAutoloadConfigLoadErrorMessage))
        return
    end

    saveManager.Library:Notify(string.format("Successfully loaded autoload config %q", loadAutoloadConfigConfigName))
end

function saveManager:DeleteAutoLoadConfig(): (boolean, string?)
    saveManager:CheckFolderTree()

    local deleteAutoLoadConfigAutoloadPath = saveManagerGetAutoloadPath()
    if deleteAutoLoadConfigAutoloadPath == false then
        return false, "Invalid path provided"
    end

    if not saveManagerIsfile(deleteAutoLoadConfigAutoloadPath) then
        return false, "Autoload config is not set"
    end

    local deleteAutoLoadConfigSuccessDelete, deleteAutoLoadConfigErrorMessage = pcall(delfile, deleteAutoLoadConfigAutoloadPath)
    if not deleteAutoLoadConfigSuccessDelete then
        return false, deleteAutoLoadConfigErrorMessage
    end

    saveManager.AutoloadConfig = nil
    return true
end

local function saveManagerShowDialog(
    showDialogCondition: () -> boolean,

    showDialogIndex: string, 
    showDialogTitle: string, 
    showDialogDescription: string,

    showDialogDestructiveText: string,
    showDialogDestructiveAction: () -> nil
)
    if showDialogCondition() == false then
        return showDialogDestructiveAction()
    end

    return saveManager.Library.Window:AddDialog(showDialogIndex, {
        Title = showDialogTitle,
        Description = showDialogDescription,
        AutoDismiss = false,

        FooterButtons = {
            Cancel = {
                Title = "Cancel",
                Variant = "Ghost",
                Order = 1,
                Callback = function(addDialog)
                    addDialog:Dismiss()
                end
            },

            DestructiveAction = {
                Title = showDialogDestructiveText,
                Variant = "Destructive",
                Order = 2,
                Callback = function(addDialog)
                    addDialog:Dismiss()
                    showDialogDestructiveAction()
                end
            }
        }
    })
end

function saveManager:BuildConfigSection(buildConfigSectionTab: any, buildConfigSectionIconName: string)
    assert(saveManager.Library, "Library is not set, call SaveManager:SetLibrary(Library) first.")
    local buildConfigSectionConfigurationBox = buildConfigSectionTab:AddGroupbox({
        Side = "Right",
        Name = "Configuration",
        IconName = buildConfigSectionIconName or "folder-cog",
    })

    local buildConfigSectionConfigNameInput, buildConfigSectionConfigList, buildConfigSectionConfigJSONInput, buildConfigSectionAutoloadConfigLabel
    local function buildConfigSectionRefreshList()
        buildConfigSectionConfigList:SetValues(saveManager:RefreshConfigList())
        buildConfigSectionConfigList:SetValue(nil)
    end

    local function buildConfigSectionRefreshAutoloadConfigLabel()
        local refreshAutoloadConfigLabelAutoloadConfigName, _refreshAutoloadConfigLabelSuccess, _refreshAutoloadConfigLabelErrorMessage = saveManager:GetAutoloadConfig()

        buildConfigSectionAutoloadConfigLabel:SetText(string.format("Current autoload config: %s", refreshAutoloadConfigLabelAutoloadConfigName))
        if buildConfigSectionConfigList then buildConfigSectionRefreshList() end
    end

    buildConfigSectionConfigurationBox:AddInput("SaveManager_ConfigName", {
        Text = "Config name"
    })

    buildConfigSectionConfigurationBox:AddButton("Create config", function()
        local createConfigConfigName = buildConfigSectionConfigNameInput.Value
        if saveManagerIsStringEmpty(createConfigConfigName) then
            saveManager.Library:Notify("Configuration name cannot be empty.")
            return
        end

        if string.lower(createConfigConfigName) == "autoload" then
            saveManager.Library:Notify("Invalid config name provided.")
            return
        end
        
        saveManagerShowDialog(
            function(): boolean
                return saveManagerDoesConfigExist(createConfigConfigName)
            end,

            "SaveManager_CreateConfig",
            "Config already exists",
            string.format("A config named %q already exists. Overwriting will replace it with your current settings.", createConfigConfigName),

            "Overwrite",
            function()
                local createConfigSuccess, createConfigErrorMessage = saveManager:Save(createConfigConfigName)
                if not createConfigSuccess then
                    saveManager.Library:Notify(string.format("Failed to create config %q: %s", createConfigConfigName, createConfigErrorMessage))
                    return
                end

                saveManager.Library:Notify(string.format("Successfully created config %q", createConfigConfigName))
                buildConfigSectionRefreshList()
            end
        )
    end)

    buildConfigSectionConfigurationBox:AddDivider()

    buildConfigSectionConfigurationBox:AddDropdown("SaveManager_ConfigList", {
        Text = "Config list",

        Values = saveManager:RefreshConfigList(),
        AllowNull = true,
        Multi = false,

        FormatDisplayValue = function(configList: any)
            if configList == saveManager.AutoloadConfig then
                return string.format("%s (autoload)", configList)
            end

            return configList
        end,
        FormatListValue = function(configList: any)
            if configList == saveManager.AutoloadConfig then
                return string.format("%s (autoload)", configList)
            end

            return configList
        end
    })

    buildConfigSectionConfigurationBox:AddButton({
        Text = "Load config",
        DoubleClick = false,

        Func = function()
            local loadConfigConfigName = buildConfigSectionConfigList.Value
            if saveManagerIsStringEmpty(loadConfigConfigName) then
                saveManager.Library:Notify("Please select a config first.")
                return
            end

            saveManagerShowDialog(
                function(): boolean
                    return true 
                end,

                "SaveManager_LoadConfig",
                "Load config",
                string.format("Are you sure you want to load %q? Your current settings will be overwritten.", loadConfigConfigName),

                "Load",
                function()
                    local loadConfigSuccess, loadConfigErrorMessage = saveManager:Load(loadConfigConfigName)
                    if not loadConfigSuccess then
                        saveManager.Library:Notify(string.format("Failed to load config %q: %s", loadConfigConfigName, loadConfigErrorMessage))
                        return
                    end

                    saveManager.Library:Notify(string.format("Successfully loaded config %q", loadConfigConfigName))
                end
            )
        end
    })
    
    buildConfigSectionConfigurationBox:AddButton({
        Text = "Overwrite config",
        DoubleClick = false,

        Func = function()
            local overwriteConfigConfigName = buildConfigSectionConfigList.Value
            if saveManagerIsStringEmpty(overwriteConfigConfigName) then
                saveManager.Library:Notify("Please select a config first.")
                return
            end

            saveManagerShowDialog(
                function(): boolean
                    return true 
                end,

                "SaveManager_OverwriteConfig",
                "Overwrite config",
                string.format("Are you sure you want to overwrite %q with your current settings? This cannot be undone.", overwriteConfigConfigName),

                "Overwrite",
                function()
                    local overwriteConfigSuccess, overwriteConfigErrorMessage = saveManager:Save(overwriteConfigConfigName)
                    if not overwriteConfigSuccess then
                        saveManager.Library:Notify(string.format("Failed to overwrite config %q: %s", overwriteConfigConfigName, overwriteConfigErrorMessage))
                        return
                    end

                    saveManager.Library:Notify(string.format("Successfully overwrote config %q", overwriteConfigConfigName))
                end
            )
        end
    })

    buildConfigSectionConfigurationBox:AddButton({
        Text = "Delete config",
        DoubleClick = false,

        Func = function()
            local deleteConfigConfigName = buildConfigSectionConfigList.Value
            if saveManagerIsStringEmpty(deleteConfigConfigName) then
                saveManager.Library:Notify("Please select a config first.")
                return
            end

            saveManagerShowDialog(
                function(): boolean
                    return true 
                end,

                "SaveManager_DeleteConfig",
                "Delete config",
                string.format("Are you sure you want to delete %q? This cannot be undone.", deleteConfigConfigName),
                
                "Delete",
                function()
                    local deleteConfigSuccess, deleteConfigErrorMessage = saveManager:Delete(deleteConfigConfigName)
                    if not deleteConfigSuccess then
                        saveManager.Library:Notify(string.format("Failed to delete config %q: %s", deleteConfigConfigName, deleteConfigErrorMessage))
                        return
                    end

                    saveManager.Library:Notify(string.format("Successfully deleted config %q", deleteConfigConfigName))
                    buildConfigSectionRefreshAutoloadConfigLabel()
                end
            )
        end
    })

    buildConfigSectionConfigurationBox:AddButton("Refresh list", buildConfigSectionRefreshList)

    buildConfigSectionConfigurationBox:AddButton({
        Text = "Set as autoload",
        DoubleClick = false,

        Func = function()
            local setAsAutoloadConfigName = buildConfigSectionConfigList.Value
            if saveManagerIsStringEmpty(setAsAutoloadConfigName) then
                saveManager.Library:Notify("Please select a config first.")
                return
            end

            local setAsAutoloadSuccess, setAsAutoloadErrorMessage = saveManager:SaveAutoloadConfig(setAsAutoloadConfigName)
            if not setAsAutoloadSuccess then
                saveManager.Library:Notify(string.format("Failed to set autoload config %q: %s", setAsAutoloadConfigName, setAsAutoloadErrorMessage))
                return
            end

            saveManager.Library:Notify(string.format("Successfully set autoload config to %q", setAsAutoloadConfigName))
            buildConfigSectionRefreshAutoloadConfigLabel()
        end
    })

    buildConfigSectionConfigurationBox:AddButton({
        Text = "Reset autoload",
        DoubleClick = false,

        Func = function()
            saveManagerShowDialog(
                function(): boolean
                    return true 
                end,

                "SaveManager_ResetAutoload",
                "Reset autoload config",
                "Are you sure you want to clear the autoload config? No config will be loaded automatically on next launch.",
                
                "Reset",
                function()
                    local resetAutoloadSuccess, resetAutoloadErrorMessage = saveManager:DeleteAutoLoadConfig()
                    if not resetAutoloadSuccess then
                        saveManager.Library:Notify(string.format("Failed to reset autoload config: %s", resetAutoloadErrorMessage))
                        return
                    end

                    saveManager.Library:Notify("Successfully reset autoload config.")
                    buildConfigSectionRefreshAutoloadConfigLabel()
                end
            )
        end
    })

    buildConfigSectionAutoloadConfigLabel = buildConfigSectionConfigurationBox:AddLabel("Current autoload config: ...", true);

    buildConfigSectionConfigurationBox:AddDivider()

    buildConfigSectionConfigurationBox:AddInput("SaveManager_JSON", {
        Text = "Config JSON"
    })

    buildConfigSectionConfigurationBox:AddButton("Import config", function()
        local importConfigConfigJSON = buildConfigSectionConfigJSONInput.Value
        if saveManagerIsStringEmpty(importConfigConfigJSON) then
            saveManager.Library:Notify("Configuration JSON cannot be empty")
            return
        end

        saveManagerShowDialog(
            function(): boolean
                return true 
            end,

            "SaveManager_ImportConfig",
            "Import config",
            "Are you sure you want to import this configuration? Your current settings will be overwritten.",

            "Import",
            function()
                local importConfigSuccess, importConfigErrorMessage = saveManager:LoadJSON(importConfigConfigJSON)
                if not importConfigSuccess then
                    saveManager.Library:Notify(string.format("Failed to import config: %s", importConfigErrorMessage))
                    return
                end

                saveManager.Library:Notify("Successfully imported config")
            end
        )
    end)

    buildConfigSectionConfigurationBox:AddButton("Export current config", function()
        local exportCurrentConfigEncodedData, exportCurrentConfigSuccess, exportCurrentConfigErrorMessage = saveManager:SaveJSON()
        if not exportCurrentConfigSuccess  then
            saveManager.Library:Notify(exportCurrentConfigErrorMessage)
            return
        end

        buildConfigSectionConfigJSONInput:SetValue(exportCurrentConfigEncodedData)
        if setclipboard then
            setclipboard(exportCurrentConfigEncodedData)
            saveManager.Library:Notify("Copied config to your clipboard")
        end
    end)

    buildConfigSectionConfigNameInput, buildConfigSectionConfigList, buildConfigSectionConfigJSONInput =
        saveManager.Library.Options.SaveManager_ConfigName, 
        saveManager.Library.Options.SaveManager_ConfigList,
        saveManager.Library.Options.SaveManager_JSON;

    buildConfigSectionRefreshAutoloadConfigLabel()
    saveManager:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName", "SaveManager_JSON" })

    return buildConfigSectionConfigurationBox
end

saveManager:BuildFolderTree()
return saveManager

