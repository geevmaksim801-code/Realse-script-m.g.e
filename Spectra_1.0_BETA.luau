        local getAssetAssetID = string.format("rbxassetid://%s", getAssetAssetData.RobloxId)

        if getcustomasset then
            local getAssetSuccess, getAssetNewID = pcall(getcustomasset, getAssetAssetData.Path)

            if getAssetSuccess and getAssetNewID then
                getAssetAssetID = getAssetNewID
            end
        end

        getAssetAssetData.Id = getAssetAssetID
        return getAssetAssetID
    end

