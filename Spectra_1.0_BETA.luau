            if library.Toggled then
                createWindowFadeInstance(createWindowMainFrame, { "BackgroundTransparency" })
                task.wait(toggleFadeTime / 2)
            else
                task.delay(toggleFadeTime / 2, createWindowFadeInstance, createWindowMainFrame, { "BackgroundTransparency" })
            end

            for _toggleUnused1, toggleInstance in createWindowMainFrame:GetDescendants() do
                if toggleInstance == createWindowTopBar then
                    continue
                end

                if toggleInstance:IsA("GuiObject") then
                    local toggleClassName = toggleInstance.ClassName
                    if toggleClassName == "ImageLabel" or toggleClassName == "ImageButton" then
                        createWindowFadeInstance(toggleInstance, createWindowImageProperties)
                    elseif toggleClassName == "TextLabel" or toggleClassName == "TextBox" or toggleClassName == "TextButton" then
                        createWindowFadeInstance(toggleInstance, createWindowTextProperties)
                    else
                        createWindowFadeInstance(toggleInstance, createWindowGuiProperties)
                    end
                elseif toggleInstance.ClassName == "UIStroke" then
                    createWindowFadeInstance(toggleInstance, createWindowStrokeProperties)
                end
            end

            task.delay(toggleFadeTime, function()
                createWindowMainFrame.Visible = library.Toggled
                createWindowFading = false
