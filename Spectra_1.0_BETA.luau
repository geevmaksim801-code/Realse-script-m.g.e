function themeManager:Delete(deleteThemeName: string): (boolean | string?)
    if themeManagerIsStringEmpty(deleteThemeName) then
        return false, "No theme is selected"
    end

    local deleteThemePath = themeManagerGetThemePath(deleteThemeName)
    if deleteThemePath == false or not themeManagerIsfile(deleteThemePath) then
        return false, "Theme file does not exist"
    end

    local deleteSuccessDelete, deleteErrorMessage = pcall(delfile, deleteThemePath)
    if not deleteSuccessDelete then
        return false, "Failed to delete theme file: " .. tostring(deleteErrorMessage)
    end

    if deleteThemeName == themeManager.DefaultThemeName then
        themeManager:DeleteDefaultTheme()
    end

    return true
end

function themeManager:GetDefaultTheme(): (string, boolean, string?)
    themeManager:CheckFolderTree()

    local getDefaultThemeDefaultThemePath = themeManagerGetDefaultThemePath()
    if getDefaultThemeDefaultThemePath == false then
        return "none", false, "Invalid path provided"
    end

    if not themeManagerIsfile(getDefaultThemeDefaultThemePath) then
        return "none", false, "Default theme is not set"
    end

    local getDefaultThemeSuccessRead, getDefaultThemeDefaultThemeName = pcall(readfile, getDefaultThemeDefaultThemePath)
    if not (getDefaultThemeSuccessRead and typeof(getDefaultThemeDefaultThemeName) == "string") then
        return "none", false, getDefaultThemeDefaultThemeName
    end

    local getDefaultThemeConfigExists = themeManagerDoesThemeExist(getDefaultThemeDefaultThemeName, true)
    if not getDefaultThemeConfigExists then
        return "none", false, "Theme file not found"
    end

    themeManager.DefaultThemeName = getDefaultThemeDefaultThemeName
    return getDefaultThemeDefaultThemeName, true
end

function themeManager:SetDefaultTheme(setDefaultThemeTheme: any)
    assert(themeManager.Library, "Library is not set, call ThemeManager:SetLibrary(Library) first.")
    assert(not themeManager.AppliedToTab, "Cannot set default theme after applying ThemeManager to a tab!")

    local setDefaultThemeLibrary = themeManager.Library
    local setDefaultThemeDefaultThemeData = themeManager.BuiltInThemes["Default"][2]

    local setDefaultThemeLibraryScheme = {}
    local setDefaultThemeFinalTheme = {}

    for _setDefaultThemeUnused1, setDefaultThemeSchemeIndex in themeManagerSchemeIndexes do
        local setDefaultThemeIndexData = setDefaultThemeTheme[setDefaultThemeSchemeIndex]
        local setDefaultThemeIndexType = typeof(setDefaultThemeIndexData)
        
        if setDefaultThemeIndexType == "Color3" then
            setDefaultThemeLibraryScheme[setDefaultThemeSchemeIndex] = setDefaultThemeIndexData
            setDefaultThemeFinalTheme[setDefaultThemeSchemeIndex] = string.format("#%s", setDefaultThemeIndexData:ToHex())

        elseif setDefaultThemeIndexType == "string" then
            setDefaultThemeLibraryScheme[setDefaultThemeSchemeIndex] = Color3.fromHex(setDefaultThemeIndexData)
            setDefaultThemeFinalTheme[setDefaultThemeSchemeIndex] = if setDefaultThemeIndexData:sub(1, 1) == "#" then setDefaultThemeIndexData else string.format("#%s", setDefaultThemeIndexData)
        
        else
            local setDefaultThemeValue = setDefaultThemeDefaultThemeData[setDefaultThemeSchemeIndex]
            setDefaultThemeLibraryScheme[setDefaultThemeSchemeIndex] = Color3.fromHex(setDefaultThemeValue)
            setDefaultThemeFinalTheme[setDefaultThemeSchemeIndex] = setDefaultThemeValue
        end
    end

    local setDefaultThemeFontFace = setDefaultThemeTheme["FontFace"]
    local setDefaultThemeFontFaceType = typeof(setDefaultThemeFontFace)
    
    if setDefaultThemeFontFaceType == "EnumItem" then
        setDefaultThemeLibraryScheme.Font = Font.fromEnum(setDefaultThemeFontFace)
        setDefaultThemeFinalTheme.FontFace = setDefaultThemeFontFace.Name

    elseif setDefaultThemeFontFaceType == "string" then
        setDefaultThemeLibraryScheme.Font = Font.fromEnum(Enum.Font[setDefaultThemeFontFace] :: Enum.Font)
        setDefaultThemeFinalTheme.FontFace = setDefaultThemeFontFace
    
    else
        setDefaultThemeLibraryScheme.Font = Font.fromEnum(Enum.Font.Code)
        setDefaultThemeFinalTheme.FontFace = "Code"
    end

    for _setDefaultThemeUnused2, setDefaultThemeDefaultSchemeColor in { "RedColor", "DestructiveColor", "DarkColor", "WhiteColor" } do
        setDefaultThemeLibraryScheme[setDefaultThemeDefaultSchemeColor] = setDefaultThemeLibrary.Scheme[setDefaultThemeDefaultSchemeColor]
    end

    setDefaultThemeLibrary.Scheme = setDefaultThemeLibraryScheme
    themeManager.BuiltInThemes["Default"] = { 1, setDefaultThemeFinalTheme }

    setDefaultThemeLibrary:UpdateColorsUsingRegistry()
end

