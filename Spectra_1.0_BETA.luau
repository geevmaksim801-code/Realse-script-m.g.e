local function libraryGetSnapEdges(getSnapEdgesElemSize: Vector2, getSnapEdgesViewportSize: Vector2, getSnapEdgesMargin: number, getSnapEdgesAvoidCoreGui: boolean)
    local getSnapEdgesSafeMin, getSnapEdgesSafeMax = Vector2.zero, getSnapEdgesViewportSize

    if getSnapEdgesAvoidCoreGui then
        local getSnapEdgesTopLeftInset, getSnapEdgesBottomRightInset = libraryGetCoreGuiInset()
        getSnapEdgesSafeMin = getSnapEdgesTopLeftInset
        getSnapEdgesSafeMax = getSnapEdgesViewportSize - getSnapEdgesBottomRightInset
    end

    local getSnapEdgesTargetsX = {
        LeftEdge = getSnapEdgesSafeMin.X + getSnapEdgesMargin,
        Center = getSnapEdgesSafeMin.X + (getSnapEdgesSafeMax.X - getSnapEdgesSafeMin.X - getSnapEdgesElemSize.X) / 2,
        RightEdge = getSnapEdgesSafeMax.X - getSnapEdgesElemSize.X - getSnapEdgesMargin,
    }
    local getSnapEdgesTargetsY = {
        TopEdge = getSnapEdgesSafeMin.Y + getSnapEdgesMargin,
        Center = getSnapEdgesSafeMin.Y + (getSnapEdgesSafeMax.Y - getSnapEdgesSafeMin.Y - getSnapEdgesElemSize.Y) / 2,
        BottomEdge = getSnapEdgesSafeMax.Y - getSnapEdgesElemSize.Y - getSnapEdgesMargin,
    }

    return getSnapEdgesTargetsX, getSnapEdgesTargetsY
end

local function libraryGetClosestSnapTarget(getClosestSnapTargetParameter: number, getClosestSnapTargetTargets: { [string]: number }, getClosestSnapTargetDistance: number): (number?, string?)
    local getClosestSnapTargetClosestName, getClosestSnapTargetClosestValue, getClosestSnapTargetClosestDist = nil, nil, getClosestSnapTargetDistance

    for getClosestSnapTargetName, getClosestSnapTargetTarget in getClosestSnapTargetTargets do
        local getClosestSnapTargetDist = math.abs(getClosestSnapTargetParameter - getClosestSnapTargetTarget)
        if getClosestSnapTargetDist <= getClosestSnapTargetClosestDist then
            getClosestSnapTargetClosestDist = getClosestSnapTargetDist
            getClosestSnapTargetClosestName = getClosestSnapTargetName
            getClosestSnapTargetClosestValue = getClosestSnapTargetTarget
        end
    end

    return getClosestSnapTargetClosestValue, getClosestSnapTargetClosestName
end

local function libraryGetSnapGuideOffset(getSnapGuideOffsetName: string, getSnapGuideOffsetSnappedValue: number, getSnapGuideOffsetElemDimension: number): number
    if getSnapGuideOffsetName == "RightEdge" or getSnapGuideOffsetName == "BottomEdge" then
        return getSnapGuideOffsetSnappedValue + getSnapGuideOffsetElemDimension
    elseif getSnapGuideOffsetName == "Center" then
        return getSnapGuideOffsetSnappedValue + getSnapGuideOffsetElemDimension / 2
    end

    return getSnapGuideOffsetSnappedValue 
end

function library:MakeDraggable(
    makeDraggableUI: GuiObject,
    makeDraggableDragFrame: GuiObject,
    makeDraggableIgnoreToggled: boolean?,
    makeDraggableIsMainWindow: boolean?,
    makeDraggableSnapConfig: { Enabled: boolean, Distance: number?, Margin: number?, AvoidCoreGui: boolean? }?
)
    local makeDraggableStartPos
    local makeDraggableFramePos
    local makeDraggableDragging = false
    local makeDraggableChanged
    local makeDraggableInputBegan
    local makeDraggableInputChanged

    local makeDraggableSnapGuideX, makeDraggableSnapGuideY

    local function makeDraggableGetSnapGuides()
        if not makeDraggableSnapGuideX then
            makeDraggableSnapGuideX = libraryNew("Frame", {
                BackgroundColor3 = "AccentColor",
                BackgroundTransparency = 0.25,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0),
                Size = UDim2.new(0, 2, 1, 0),
                Visible = false,
                ZIndex = 10000,
                Parent = libraryScreenGui,
            })
        end

        if not makeDraggableSnapGuideY then
            makeDraggableSnapGuideY = libraryNew("Frame", {
                BackgroundColor3 = "AccentColor",
                BackgroundTransparency = 0.25,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(1, 0, 0, 2),
                Visible = false,
                ZIndex = 10000,
                Parent = libraryScreenGui,
            })
        end

        return makeDraggableSnapGuideX, makeDraggableSnapGuideY
    end

    local function makeDraggableHideSnapGuides()
        if makeDraggableSnapGuideX then
            makeDraggableSnapGuideX.Visible = false
        end
        if makeDraggableSnapGuideY then
            makeDraggableSnapGuideY.Visible = false
        end
    end

    makeDraggableInputBegan = makeDraggableDragFrame.InputBegan:Connect(function(makeDraggableInput: InputObject)
        if not libraryIsClickInput(makeDraggableInput) or makeDraggableIsMainWindow and library.CantDragForced then
            return
        end

        makeDraggableStartPos = makeDraggableInput.Position
        makeDraggableFramePos = makeDraggableUI.Position
        makeDraggableDragging = true

        makeDraggableChanged = makeDraggableInput.Changed:Connect(function()
            if makeDraggableInput.UserInputState ~= Enum.UserInputState.End then
                return
            end

            makeDraggableDragging = false
            makeDraggableHideSnapGuides()

            if makeDraggableChanged and makeDraggableChanged.Connected then
                makeDraggableChanged:Disconnect()
                makeDraggableChanged = nil
            end
        end)
    end)

    makeDraggableInputChanged = libraryUserInputService.InputChanged:Connect(function(makeDraggableInput: InputObject)
        if
            (not makeDraggableIgnoreToggled and not library.Toggled)
            or (makeDraggableIsMainWindow and library.CantDragForced)
            or not (libraryScreenGui and libraryScreenGui.Parent)
        then
            makeDraggableDragging = false
            makeDraggableHideSnapGuides()

            if makeDraggableChanged and makeDraggableChanged.Connected then
                makeDraggableChanged:Disconnect()
                makeDraggableChanged = nil
            end

            return
        end

        if makeDraggableDragging and libraryIsHoverInput(makeDraggableInput) then
            local makeDraggableDelta = makeDraggableInput.Position - makeDraggableStartPos
            local makeDraggableNewX = makeDraggableFramePos.X.Offset + makeDraggableDelta.X
            local makeDraggableNewY = makeDraggableFramePos.Y.Offset + makeDraggableDelta.Y

            if makeDraggableSnapConfig and makeDraggableSnapConfig.Enabled then
                local makeDraggableViewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
                local makeDraggableDistance = makeDraggableSnapConfig.Distance or 28
                local makeDraggableMargin = makeDraggableSnapConfig.Margin or 8

                local makeDraggableAbsX = makeDraggableFramePos.X.Scale * makeDraggableViewportSize.X + makeDraggableNewX
                local makeDraggableAbsY = makeDraggableFramePos.Y.Scale * makeDraggableViewportSize.Y + makeDraggableNewY

                local makeDraggableElemSize = makeDraggableUI.AbsoluteSize
                local makeDraggableTargetsX, makeDraggableTargetsY = libraryGetSnapEdges(makeDraggableElemSize, makeDraggableViewportSize, makeDraggableMargin, makeDraggableSnapConfig.AvoidCoreGui ~= false)
                local makeDraggableSnappedX, makeDraggableSnappedXName = libraryGetClosestSnapTarget(makeDraggableAbsX, makeDraggableTargetsX, makeDraggableDistance)
                local makeDraggableSnappedY, makeDraggableSnappedYName = libraryGetClosestSnapTarget(makeDraggableAbsY, makeDraggableTargetsY, makeDraggableDistance)

                if makeDraggableSnappedX then
                    makeDraggableNewX = makeDraggableSnappedX - makeDraggableFramePos.X.Scale * makeDraggableViewportSize.X
                end
                if makeDraggableSnappedY then
                    makeDraggableNewY = makeDraggableSnappedY - makeDraggableFramePos.Y.Scale * makeDraggableViewportSize.Y
                end

                local makeDraggableGuideX, makeDraggableGuideY = makeDraggableGetSnapGuides()
                makeDraggableGuideX.Visible = makeDraggableSnappedX ~= nil
                if makeDraggableSnappedX then
                    makeDraggableGuideX.Position = UDim2.fromOffset(libraryGetSnapGuideOffset(makeDraggableSnappedXName, makeDraggableSnappedX, makeDraggableElemSize.X), 0)
                end

                makeDraggableGuideY.Visible = makeDraggableSnappedY ~= nil
                if makeDraggableSnappedY then
