    function createWindowWindow:SetCornerRadius(setCornerRadiusRadius: number)
        assert(typeof(setCornerRadiusRadius) == "number", "Expected number for Radius got: " .. typeof(setCornerRadiusRadius))
        setCornerRadiusRadius = math.min(setCornerRadiusRadius, 20)

        local setCornerRadiusRadiusHalf = UDim.new(0, setCornerRadiusRadius / 2)
        local setCornerRadiusRadiusUDim = UDim.new(0, setCornerRadiusRadius)
        local setCornerRadiusHalfCurrent = library.CornerRadius / 2

        for _setCornerRadiusUnused1, setCornerRadiusUICorner in library.Corners do
            if math.abs(setCornerRadiusUICorner.CornerRadius.Offset - setCornerRadiusHalfCurrent) < 0.001 then
                setCornerRadiusUICorner.CornerRadius = setCornerRadiusRadiusHalf
            else
                setCornerRadiusUICorner.CornerRadius = setCornerRadiusRadiusUDim
            end
        end

        for _setCornerRadiusUnused2, setCornerRadiusUICorner in library.SpecificCorners do
            createWindowSetUICorner(setCornerRadiusUICorner, "TopRightRadius", setCornerRadiusRadiusHalf)
            createWindowSetUICorner(setCornerRadiusUICorner, "TopLeftRadius", setCornerRadiusRadiusHalf)
            createWindowSetUICorner(setCornerRadiusUICorner, "BottomRightRadius", setCornerRadiusRadiusHalf)
            createWindowSetUICorner(setCornerRadiusUICorner, "BottomLeftRadius", setCornerRadiusRadiusHalf)
        end

        library.CornerRadius = setCornerRadiusRadius
        createWindowWindowInfo.CornerRadius = setCornerRadiusRadius

        if createWindowResizeButton then
            createWindowResizeButton.Position = UDim2.new(1, -setCornerRadiusRadius / 4, 0, 0)
        end
        if createWindowBottomBackgroundCorner then
            createWindowBottomBackgroundCorner.BottomLeftRadius = setCornerRadiusRadiusUDim
            createWindowBottomBackgroundCorner.BottomRightRadius = setCornerRadiusRadiusUDim
        end

        for _setCornerRadiusUnused3, setCornerRadiusMenu in library.ContextMenus do
            if setCornerRadiusMenu.Destroyed then
                continue
            end

            if typeof(setCornerRadiusMenu.ActiveCallback) ~= "function" then
                continue
            end

            if not setCornerRadiusMenu.Active then
                local setCornerRadiusHolderActive = false
                for _setCornerRadiusUnused4, setCornerRadiusOther in library.ContextMenus do
                    if setCornerRadiusOther == setCornerRadiusMenu then 
                        continue
                    end
   
                    if setCornerRadiusOther.Active and setCornerRadiusOther.Holder == setCornerRadiusMenu.Holder then
                        setCornerRadiusHolderActive = true
                        break
                    end
                end

                if setCornerRadiusHolderActive then
                    continue
                end

                setCornerRadiusMenu.ActiveCallback(false)
                continue
            end

            setCornerRadiusMenu.ActiveCallback(true)
        end

        for _setCornerRadiusUnused5, setCornerRadiusOption in libraryOptions do
            if setCornerRadiusOption.Type == "Dropdown" and setCornerRadiusOption.RefreshPool then
                setCornerRadiusOption:RefreshPool()
            end
        end

        for _setCornerRadiusUnused6, setCornerRadiusTab in library.Tabs do
            if setCornerRadiusTab.IsKeyTab then
                continue
            end

            for _setCornerRadiusUnused7, setCornerRadiusTabbox in setCornerRadiusTab.Tabboxes do
                setCornerRadiusTabbox:UpdateCorners()
            end
        end
    end

