        end
    end

    local notifyTextContainer = libraryNew("Frame", {
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.fromOffset(0, 0),
        Parent = notifyContentContainer,
    })
    libraryNew("UIListLayout", {
        Padding = UDim.new(0, 4),
        Parent = notifyTextContainer,
    })

    local notifyTitleContainer
    if notifyData.Title then
        notifyTitleContainer = libraryNew("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(0, 0),
            Parent = notifyTextContainer,
        })
    end

    local notifyIconLabel
    if notifyData.Icon and notifyTitleContainer then
        local notifyParsedIcon = library:GetCustomIcon(notifyData.Icon)
        if notifyParsedIcon then
            notifyIconLabel = libraryNew("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 0, 0.5, 1),
                Size = UDim2.fromOffset(15, 15),
                ImageColor3 = notifyData.IconColor or "FontColor",
                Parent = notifyTitleContainer,
            })
            library:ApplyLucideIcon(notifyIconLabel, notifyParsedIcon)
        end
    end

    local notifyTitle
    local notifyDesc
    local notifyTitleX = 0
    local notifyDescX = 0

    local notifyTimerFill

    if notifyData.Title then
        notifyTitle = libraryNew("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.None,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, (notifyIconLabel and 21 or 0), 0.5, 0),
            Size = UDim2.fromScale(0, 0),
            Text = notifyData.Title,
            TextColor3 = notifyData.TitleColor or "FontColor",
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
            Parent = notifyTitleContainer,
        })
    end

    if notifyData.Description then
        notifyDesc = libraryNew("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.None,
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(0, 0),
            Text = notifyData.Description,
            TextColor3 = notifyData.DescriptionColor or "FontColor",
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = notifyTextContainer,
        })
    end

    function notifyData:Resize()
        local resizeExtraWidth = notifyBigIconLabel and 32 or 0
        local resizeIconWidth = notifyIconLabel and 21 or 0
        local resizeCloseWidth = notifyData.Closable and 20 or 0
        local resizeMaxTextWidth = math.max(
            40,
            (libraryNotificationArea.AbsoluteSize.X / library.DPIScale) - 24 - resizeExtraWidth - resizeCloseWidth
        )

        if notifyTitle then
            local resizeX, resizeY = library:GetTextBounds(notifyTitle.Text, notifyTitle.FontFace, notifyTitle.TextSize, resizeMaxTextWidth - resizeIconWidth)
            notifyTitle.Size = UDim2.fromOffset(resizeX, resizeY)
            notifyTitleX = resizeX + resizeIconWidth
            notifyTitleContainer.Size = UDim2.fromOffset(notifyTitleX, math.max(resizeY, notifyIconLabel and 16 or 0))
        end

        if notifyDesc then
            local resizeX, resizeY = library:GetTextBounds(notifyDesc.Text, notifyDesc.FontFace, notifyDesc.TextSize, resizeMaxTextWidth)
            notifyDesc.Size = UDim2.fromOffset(resizeX, resizeY)
            notifyDescX = resizeX
        end

        notifyFakeBackground.Size = UDim2.fromOffset(math.max(notifyTitleX, notifyDescX) + 24 + resizeExtraWidth + resizeCloseWidth, 0)

        if library.Notifications[notifyFakeBackground] then
            task.defer(function()
                if notifyData.Destroyed or not notifyFakeBackground.Parent then
                    return
                end

                if notifyFakeBackground.AbsoluteSize.Y <= 0 then
                    task.defer(function()
                        if notifyData.Destroyed or not notifyFakeBackground.Parent then
                            return
                        end

                        library:UpdateNotificationPositions(true)
                    end)
                    return
                end

                library:UpdateNotificationPositions(true)
            end)
        end
    end

    function notifyData:ChangeTitle(changeTitleText)
        if notifyTitle then
            notifyData.Title = tostring(changeTitleText)
            notifyTitle.Text = notifyData.Title
            notifyData:Resize()
        end
    end

    function notifyData:ChangeDescription(changeDescriptionText)
        if notifyDesc then
            notifyData.Description = tostring(changeDescriptionText)
            notifyDesc.Text = notifyData.Description
            notifyData:Resize()
        end
    end

    function notifyData:ChangeStep(changeStepNewStep)
        if notifyTimerFill and notifyData.Steps then
            changeStepNewStep = math.clamp(changeStepNewStep or 0, 0, notifyData.Steps)
            notifyTimerFill.Size = UDim2.fromScale(changeStepNewStep / notifyData.Steps, 1)
        end
    end

    function notifyData:Destroy(destroyReason)
        if notifyData.Destroyed then
            return
        end

        destroyReason = destroyReason or "script"
        notifyData.Destroyed = true

        if notifyData.Callback then
            pcall(notifyData.Callback, destroyReason)
        end

        if typeof(notifyData.Time) == "Instance" then
            pcall(notifyData.Time.Destroy, notifyData.Time)
        end

        if notifyDeleteConnection then
            notifyDeleteConnection:Disconnect()
        end

        if notifyFakeBackground then
            local destroyIdx = table.find(libraryNotifyOrder, notifyFakeBackground)
            if destroyIdx then
                table.remove(libraryNotifyOrder, destroyIdx)
            end
        end

        library:UpdateNotificationPositions()

        libraryTweenService
            :Create(notifyHolder, library.NotifyTweenInfo, {
                Position = library.NotifySide:lower() == "left" and UDim2.new(-1, -8, 0, -2) or UDim2.new(1, 8, 0, -2),
            })
            :Play()

        task.delay(library.NotifyTweenInfo.Time, function()
            library.Notifications[notifyFakeBackground] = nil
            notifyFakeBackground:Destroy()
        end)
    end

    local notifyTimerHolder = libraryNew("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 7),
        Visible = (notifyData.Persist ~= true and typeof(notifyData.Time) ~= "Instance") or typeof(notifyData.Steps) == "number",
        Parent = notifyContentHolder,
    })
    local notifyTimerBar = libraryNew("Frame", {
        BackgroundColor3 = "BackgroundColor",
        BorderColor3 = "OutlineColor",
        BorderSizePixel = 1,
        Position = UDim2.fromOffset(0, 3),
