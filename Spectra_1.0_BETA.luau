local function libraryRound(roundParameter, rounding)
    assert(rounding >= 0, "Invalid rounding number.")

    if rounding == 0 then
        return math.floor(roundParameter)
    end

    return tonumber(string.format("%." .. rounding .. "f", roundParameter))
end

local function libraryFuzzyScore(fuzzyScoreText: string, fuzzyScoreSearch: string): (boolean, number)
    if fuzzyScoreSearch == "" then
        return true, 0
    end
    if fuzzyScoreText == "" then
        return false, 0
    end

    local fuzzyScoreExactIdx = fuzzyScoreText:find(fuzzyScoreSearch, 1, true)
    if fuzzyScoreExactIdx then
        local fuzzyScorePrevChar = fuzzyScoreExactIdx > 1 and fuzzyScoreText:sub(fuzzyScoreExactIdx - 1, fuzzyScoreExactIdx - 1) or ""
        local fuzzyScoreAtBoundary = fuzzyScoreExactIdx == 1 or fuzzyScorePrevChar:match("[%s%p_]") ~= nil

        return true, 1e5 - fuzzyScoreExactIdx + (fuzzyScoreAtBoundary and 500 or 0) + (fuzzyScoreSearch:len() * 5)
    end

    local fuzzyScoreTextLen, fuzzyScoreSearchLen = fuzzyScoreText:len(), fuzzyScoreSearch:len()
    if fuzzyScoreSearchLen > fuzzyScoreTextLen then
        return false, 0
    end

    local fuzzyScoreSearchIdx = 1
    local fuzzyScoreScore = 0
    local fuzzyScoreRunLength = 0
    local fuzzyScoreLastMatchIdx = 0

    for fuzzyScoreTextIdx = 1, fuzzyScoreTextLen do
        if fuzzyScoreSearchIdx > fuzzyScoreSearchLen then
            break
        end

        if fuzzyScoreText:sub(fuzzyScoreTextIdx, fuzzyScoreTextIdx) == fuzzyScoreSearch:sub(fuzzyScoreSearchIdx, fuzzyScoreSearchIdx) then
            local fuzzyScorePrevChar = fuzzyScoreTextIdx > 1 and fuzzyScoreText:sub(fuzzyScoreTextIdx - 1, fuzzyScoreTextIdx - 1) or ""
            local fuzzyScoreAtBoundary = fuzzyScoreTextIdx == 1 or fuzzyScorePrevChar:match("[%s%p_]") ~= nil

            fuzzyScoreRunLength = (fuzzyScoreLastMatchIdx == fuzzyScoreTextIdx - 1) and (fuzzyScoreRunLength + 1) or 1
            fuzzyScoreScore += 1 + (fuzzyScoreAtBoundary and 6 or 0) + math.min(fuzzyScoreRunLength - 1, 5) * 3

            fuzzyScoreLastMatchIdx = fuzzyScoreTextIdx
            fuzzyScoreSearchIdx += 1
        end
    end

    if fuzzyScoreSearchIdx <= fuzzyScoreSearchLen then
        return false, 0 
    end

    fuzzyScoreScore -= (fuzzyScoreLastMatchIdx - fuzzyScoreSearchLen) * 0.05 
    return true, fuzzyScoreScore
end

local function libraryNormalizeSearch(normalizeSearchSearch: string): string
    return (normalizeSearchSearch:gsub("%s+", ""))
end

local function libraryTryFuzzyMatch(tryFuzzyMatchText: any, tryFuzzyMatchSearch: string): (boolean, number)
    if typeof(tryFuzzyMatchText) ~= "string" or tryFuzzyMatchText == "" then
        return false, 0
    end

    return libraryFuzzyScore(tryFuzzyMatchText:lower(), tryFuzzyMatchSearch)
end

local function libraryFuzzyMatchScore(fuzzyMatchScoreText: any, fuzzyMatchScoreSearch: string): number
    if typeof(fuzzyMatchScoreText) ~= "string" or fuzzyMatchScoreText == "" then
        return 0
    end

    local fuzzyMatchScoreNormalized = libraryNormalizeSearch(fuzzyMatchScoreText:lower())
    local fuzzyMatchScoreMatched, fuzzyMatchScoreScore = libraryFuzzyScore(fuzzyMatchScoreNormalized, fuzzyMatchScoreSearch)
    if not fuzzyMatchScoreMatched then
        return 0
    end

    if fuzzyMatchScoreNormalized == fuzzyMatchScoreSearch then
        fuzzyMatchScoreScore += 1000
    end

    return fuzzyMatchScoreScore
end

local function libraryMatchesSearch(matchesSearchElementInfo, matchesSearchSearch: string, matchesSearchForceMatch: boolean?): boolean
    if not matchesSearchElementInfo then
        return false
    end
    if matchesSearchForceMatch then
        return true
    end

    if libraryTryFuzzyMatch(matchesSearchElementInfo.Text, matchesSearchSearch) then
        return true
    end
    if libraryTryFuzzyMatch(matchesSearchElementInfo.Tooltip, matchesSearchSearch) then
        return true
    end
    if libraryTryFuzzyMatch(matchesSearchElementInfo.DisabledTooltip, matchesSearchSearch) then
        return true
    end

    if typeof(matchesSearchElementInfo.Values) == "table" then
        local matchesSearchChecked = 0
        for matchesSearchKey, matchesSearchValue in matchesSearchElementInfo.Values do
            matchesSearchChecked += 1
            if matchesSearchChecked > 200 then
                break
            end

            if libraryTryFuzzyMatch(matchesSearchValue, matchesSearchSearch) or (typeof(matchesSearchValue) ~= "string" and libraryTryFuzzyMatch(tostring(matchesSearchValue), matchesSearchSearch)) then
                return true
            end
            if typeof(matchesSearchKey) == "string" and libraryTryFuzzyMatch(matchesSearchKey, matchesSearchSearch) then
                return true
            end
        end
    end

    return false
end

local function libraryGetPlayers(getPlayersExcludeLocalPlayer: boolean?)
    local getPlayersPlayerList = libraryPlayers:GetPlayers()

    if getPlayersExcludeLocalPlayer then
        local getPlayersIdx = table.find(getPlayersPlayerList, libraryLocalPlayer)
        if getPlayersIdx then
            table.remove(getPlayersPlayerList, getPlayersIdx)
        end
    end

    table.sort(getPlayersPlayerList, function(sortPlayer1, sortPlayer2)
        return sortPlayer1.Name:lower() < sortPlayer2.Name:lower()
    end)

    return getPlayersPlayerList
end
