    function createWindowWindow:SetBackgroundImage(setBackgroundImageImage: string)
        local setBackgroundImageValidIcon = false

        if typeof(setBackgroundImageImage) == "string" then
            local setBackgroundImageBackgroundIcon = library:GetCustomIcon(setBackgroundImageImage)

            if setBackgroundImageBackgroundIcon then
                setBackgroundImageValidIcon = true

                library:ApplyLucideIcon(createWindowBackgroundImage, setBackgroundImageBackgroundIcon)
            elseif setBackgroundImageImage:match("http://") or setBackgroundImageImage:match("https://") then
                local setBackgroundImageRawFileName = setBackgroundImageImage:match("(.+)%..+$")
                local _setBackgroundImageUnused1, setBackgroundImageDomain = setBackgroundImageImage:match("^(https?://)([^/]+)");

                if setBackgroundImageRawFileName and setBackgroundImageDomain then
                    local setBackgroundImageExtention = string.sub(setBackgroundImageImage, #setBackgroundImageRawFileName + 1, #setBackgroundImageImage)
                    local setBackgroundImageFileNamePos = setBackgroundImageRawFileName:gsub("\\", "/"):find("/[^/]*$")
                    local setBackgroundImageFileName = setBackgroundImageFileNamePos and setBackgroundImageImage:sub(setBackgroundImageFileNamePos + 1) or nil

                    if setBackgroundImageFileName then
                        setBackgroundImageValidIcon = true

                        local setBackgroundImageAssetName = setBackgroundImageDomain .. setBackgroundImageFileName
                        if #setBackgroundImageAssetName > 255 then
                            local setBackgroundImageNewLength = 255 - #setBackgroundImageDomain - #setBackgroundImageExtention
                            if setBackgroundImageNewLength < 0 then
                                setBackgroundImageAssetName = setBackgroundImageDomain .. setBackgroundImageExtention
                            else
                                setBackgroundImageAssetName = setBackgroundImageDomain .. string.sub(setBackgroundImageFileName:sub(1, #setBackgroundImageFileName - #setBackgroundImageExtention), 1, setBackgroundImageNewLength) .. setBackgroundImageExtention
                            end
                        end

                        if libraryCustomImageManagerAssets[setBackgroundImageFileName] == nil then
                            libraryCustomImageManager.AddAsset(setBackgroundImageFileName, 0, setBackgroundImageImage)
                        else
                            libraryCustomImageManager.DownloadAsset(setBackgroundImageFileName, true)
                        end

                        createWindowBackgroundImage.Image = libraryCustomImageManager.GetAsset(setBackgroundImageFileName)
                        createWindowBackgroundImage.ImageRectOffset = Vector2.zero
                        createWindowBackgroundImage.ImageRectSize = Vector2.zero
                    end
                end
            end
        end

        if not setBackgroundImageValidIcon then
            createWindowBackgroundImage.Image = ""
            createWindowBackgroundImage.ImageRectOffset = Vector2.zero
            createWindowBackgroundImage.ImageRectSize = Vector2.zero
        end

        createWindowHasBackgroundImage = setBackgroundImageValidIcon
        createWindowWindowInfo.BackgroundImage = setBackgroundImageImage
    end

