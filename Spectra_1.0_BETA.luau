function themeManager:LoadDefault()
    local loadDefaultThemeName, loadDefaultSuccess, loadDefaultFetchErrorMessage = themeManager:GetDefaultTheme()
    if not loadDefaultSuccess or loadDefaultFetchErrorMessage then
        if loadDefaultFetchErrorMessage ~= "Default theme is not set" then
            themeManager.Library:Notify(string.format("Failed to apply default theme: %s", loadDefaultFetchErrorMessage))
        end

        return
    end

    if not themeManager:GetCustomTheme(loadDefaultThemeName) then
        themeManager.Library.Options.ThemeManager_ThemeList:SetValue(loadDefaultThemeName)
        return
    end

    local loadDefaultSuccessLoad, loadDefaultLoadErrorMessage = themeManager:ApplyTheme(loadDefaultThemeName)
    if not loadDefaultSuccessLoad then
        themeManager.Library:Notify(string.format("Failed to apply default theme: %s", loadDefaultLoadErrorMessage))
        return
    end

    themeManager.Library:Notify(string.format("Successfully applied default theme %q", loadDefaultThemeName))
end

