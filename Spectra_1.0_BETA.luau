local function saveManagerTrim(trimText: string)
    return trimText:match("^%s*(.-)%s*$")
end

local function saveManagerIsStringEmpty(isStringEmptyString: string): boolean
    return if typeof(isStringEmptyString) == "string" then saveManagerTrim(isStringEmptyString) == "" else true
end

local function saveManagerIsValidFolderPath(isValidFolderPathName: string): boolean
    return typeof(isValidFolderPathName) == "string" and (
        saveManagerTrim(isValidFolderPathName) ~= "" and 
        not isValidFolderPathName:match("^%s*$") and 
        not isValidFolderPathName:find('[<>:"|%?%*%z]')
    )
end

local function saveManagerSplitPath(splitPathPath: string): {string}
    local splitPathResult = {}
    local splitPathCurrent = ""

    for splitPathPart in string.gmatch(splitPathPath, "[^/]+") do
        splitPathCurrent = if splitPathCurrent == "" then splitPathPart else (splitPathCurrent .. "/" .. splitPathPart)
        table.insert(splitPathResult, splitPathCurrent)
    end

    return splitPathResult
end

