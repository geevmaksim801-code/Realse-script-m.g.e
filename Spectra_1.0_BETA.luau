local function themeManagerTrim(trimText: string)
    return trimText:match("^%s*(.-)%s*$")
end

local function themeManagerIsStringEmpty(isStringEmptyString: string): boolean
    return if typeof(isStringEmptyString) == "string" then themeManagerTrim(isStringEmptyString) == "" else true
end

local function themeManagerIsValidFolderPath(isValidFolderPathName: string): boolean
    return typeof(isValidFolderPathName) == "string" and (
        themeManagerTrim(isValidFolderPathName) ~= "" and 
        not isValidFolderPathName:match("^%s*$") and 
        not isValidFolderPathName:find('[<>:"|%?%*%z]')
    )
end

local function themeManagerLinearizeChannel(linearizeChannelChannel: number): number
    if linearizeChannelChannel <= themeManagerSrgbLinearThreshold then
        return linearizeChannelChannel / themeManagerSrgbLinearDivisor
    end

    return ((linearizeChannelChannel + themeManagerSrgbGammaOffset) / themeManagerSrgbGammaScale) ^ themeManagerSrgbGammaExponent
end

local function themeManagerGetRelativeLuminance(getRelativeLuminanceColor: Color3): number
    local getRelativeLuminanceR = themeManagerLinearizeChannel(getRelativeLuminanceColor.R)
    local getRelativeLuminanceG = themeManagerLinearizeChannel(getRelativeLuminanceColor.G)
    local getRelativeLuminanceB = themeManagerLinearizeChannel(getRelativeLuminanceColor.B)

    return themeManagerLuminanceRedWeight * getRelativeLuminanceR + themeManagerLuminanceGreenWeight * getRelativeLuminanceG + themeManagerLuminanceBlueWeight * getRelativeLuminanceB
end

local function themeManagerGetContrastRatio(getContrastRatioColorA: Color3, getContrastRatioColorB: Color3): number
    local getContrastRatioLuminanceA = themeManagerGetRelativeLuminance(getContrastRatioColorA)
    local getContrastRatioLuminanceB = themeManagerGetRelativeLuminance(getContrastRatioColorB)

    local getContrastRatioLighter = math.max(getContrastRatioLuminanceA, getContrastRatioLuminanceB)
    local getContrastRatioDarker = math.min(getContrastRatioLuminanceA, getContrastRatioLuminanceB)

    return (getContrastRatioLighter + themeManagerContrastRatioOffset) / (getContrastRatioDarker + themeManagerContrastRatioOffset)
end

local function themeManagerIsValidThemeData(isValidThemeDataData: any): boolean
    if typeof(isValidThemeDataData) ~= "table" then
