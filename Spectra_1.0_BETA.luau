            end

            recursiveCreatePathTraversedPath = recursiveCreatePathTraversedPath .. recursiveCreatePathSegment .. "/"
        end

        return recursiveCreatePathTraversedPath
    end

    function libraryCustomImageManager.AddAsset(
        addAssetAssetName: string,
        addAssetRobloxAssetId: number,
        addAssetURL: string,
        addAssetForceRedownload: boolean?
    )
        if libraryCustomImageManagerAssets[addAssetAssetName] ~= nil then
            error(string.format("Asset %q already exists", addAssetAssetName))
        end

        assert(typeof(addAssetRobloxAssetId) == "number", "RobloxAssetId must be a number")

        libraryCustomImageManagerAssets[addAssetAssetName] = {
            RobloxId = addAssetRobloxAssetId,
            Path = string.format("Obsidian/custom_assets/%s", addAssetAssetName),
            URL = addAssetURL,

