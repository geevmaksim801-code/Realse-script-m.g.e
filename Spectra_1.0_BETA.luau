        Parent = notifyTimerHolder,
    })
    notifyTimerFill = libraryNew("Frame", {
        BackgroundColor3 = "AccentColor",
        Size = UDim2.fromScale(1, 1),
        Parent = notifyTimerBar,
    })

    if typeof(notifyData.Time) == "Instance" then
        notifyTimerFill.Size = UDim2.fromScale(0, 1)
    end
    if notifyData.SoundId then
        local notifySoundId = notifyData.SoundId
        if typeof(notifySoundId) == "number" then
            notifySoundId = string.format("rbxassetid://%d", notifySoundId)
        end

        libraryNew("Sound", {
            SoundId = notifySoundId,
            Volume = tonumber(notifyData.Volume) or 3,
            PlayOnRemove = true,
            Parent = librarySoundService,
        }):Destroy()
    end

    notifyData.Holder = notifyHolder

    table.insert(libraryNotifyOrder, notifyFakeBackground)
    library.Notifications[notifyFakeBackground] = notifyData

    notifyData:Resize()

    notifyFakeBackground.Visible = true
    libraryTweenService:Create(notifyHolder, library.NotifyTweenInfo, {
        Position = UDim2.fromOffset(0, 0),
    }):Play()

    task.defer(function()
        if not notifyData.Destroyed then
            library:UpdateNotificationPositions(true)
        end
    end)

    task.delay(library.NotifyTweenInfo.Time, function()
        if notifyData.Persist then
            return
        elseif typeof(notifyData.Time) == "Instance" then
            repeat
                task.wait()
            until notifyDeletedInstance or notifyData.Destroyed
        else
            libraryTweenService
                :Create(notifyTimerFill, TweenInfo.new(notifyData.Time, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                    Size = UDim2.fromScale(0, 1),
                })
                :Play()
            task.wait(notifyData.Time)
        end

        notifyData:Destroy("timer")
    end)

    return notifyData
end

