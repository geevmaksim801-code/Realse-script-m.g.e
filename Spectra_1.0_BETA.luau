    return getKeyStringKeyCode.Name
end

function library:GetTextBounds(getTextBoundsText: string, getTextBoundsFont: Font, getTextBoundsSize: number, getTextBoundsWidth: number?): (number, number)
    local getTextBoundsScale = library.DPIScale
    local getTextBoundsParams = Instance.new("GetTextBoundsParams")
    getTextBoundsParams.Text = getTextBoundsText
    getTextBoundsParams.RichText = true
    getTextBoundsParams.Font = getTextBoundsFont
    getTextBoundsParams.Size = getTextBoundsSize * getTextBoundsScale
    if getTextBoundsWidth then
        getTextBoundsParams.Width = getTextBoundsWidth * getTextBoundsScale
    else
        getTextBoundsParams.Width = workspace.CurrentCamera.ViewportSize.X - 32
    end

    local getTextBoundsBounds = libraryTextService:GetTextBoundsAsync(getTextBoundsParams)
    return math.ceil(getTextBoundsBounds.X / getTextBoundsScale), math.ceil(getTextBoundsBounds.Y / getTextBoundsScale)
end

function library:MouseIsOverFrame(mouseIsOverFrameFrame: GuiObject, mouseIsOverFrameMouse: Vector2): boolean
    local mouseIsOverFrameAbsPos, mouseIsOverFrameAbsSize = mouseIsOverFrameFrame.AbsolutePosition, mouseIsOverFrameFrame.AbsoluteSize
    return mouseIsOverFrameMouse.X >= mouseIsOverFrameAbsPos.X
        and mouseIsOverFrameMouse.X <= mouseIsOverFrameAbsPos.X + mouseIsOverFrameAbsSize.X
        and mouseIsOverFrameMouse.Y >= mouseIsOverFrameAbsPos.Y
        and mouseIsOverFrameMouse.Y <= mouseIsOverFrameAbsPos.Y + mouseIsOverFrameAbsSize.Y
end

