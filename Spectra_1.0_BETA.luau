function themeManager:ApplyThemeData(applyThemeDataThemeData: any): (boolean, string?)
    if typeof(applyThemeDataThemeData) ~= "table" then
        return false, "Invalid theme data"
    end

    local applyThemeDataLibrary = themeManager.Library

    for applyThemeDataIndex, applyThemeDataValue in applyThemeDataThemeData do
        if applyThemeDataIndex == "VideoLink" then
            continue
        end

        local applyThemeDataElement = applyThemeDataLibrary.Options[applyThemeDataIndex]
        local applyThemeDataFinalValue = applyThemeDataValue

        if applyThemeDataIndex == "FontFace" then
            if typeof(applyThemeDataValue) ~= "string" or not Enum.Font[applyThemeDataValue] then continue end
            themeManager.Library:SetFont(Enum.Font[applyThemeDataValue])

        elseif applyThemeDataIndex == "BackgroundImage" then
            if typeof(applyThemeDataValue) ~= "string" then continue end
            themeManager.Library:SetBackgroundImage(applyThemeDataValue)

        elseif table.find(themeManagerSchemeIndexes, applyThemeDataIndex) then
            local applyThemeDataSuccessColor, applyThemeDataColor = pcall(Color3.fromHex, applyThemeDataValue)
            if not applyThemeDataSuccessColor then continue end

            applyThemeDataFinalValue = applyThemeDataColor
            applyThemeDataLibrary.Scheme[applyThemeDataIndex] = applyThemeDataFinalValue

        else
            continue 
        end

        if applyThemeDataElement then
            applyThemeDataElement:SetValue(applyThemeDataFinalValue)
        end
    end

    themeManager:ThemeUpdate()
    return true
end

function themeManager:ApplyTheme(applyThemeThemeName: string)
    if themeManagerIsStringEmpty(applyThemeThemeName) then
        return false, "No theme is selected"
    end

    local applyThemeCustomThemeData = themeManager:GetCustomTheme(applyThemeThemeName)
    local applyThemeData = applyThemeCustomThemeData or themeManager.BuiltInThemes[applyThemeThemeName]
    
    if not applyThemeData then
        return false, "Theme not found"
    end
    
    local applyThemeThemeData = applyThemeCustomThemeData or applyThemeData[2]
    return themeManager:ApplyThemeData(applyThemeThemeData)
end

