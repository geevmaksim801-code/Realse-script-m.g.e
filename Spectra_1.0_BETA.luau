function library:GetBetterColor(getBetterColorColor: Color3, getBetterColorAdd: number): Color3
    getBetterColorAdd = getBetterColorAdd * (library.IsLightTheme and -4 or 2)
    return Color3.fromRGB(
        math.clamp(getBetterColorColor.R * 255 + getBetterColorAdd, 0, 255),
        math.clamp(getBetterColorColor.G * 255 + getBetterColorAdd, 0, 255),
        math.clamp(getBetterColorColor.B * 255 + getBetterColorAdd, 0, 255)
    )
end

function library:GetLighterColor(getLighterColorColor: Color3): Color3
    local getLighterColorH, getLighterColorS, getLighterColorV = getLighterColorColor:ToHSV()
    return Color3.fromHSV(getLighterColorH, math.max(0, getLighterColorS - 0.1), math.min(1, getLighterColorV + 0.1))
end

function library:GetDarkerColor(getDarkerColorColor: Color3): Color3
    local getDarkerColorH, getDarkerColorS, getDarkerColorV = getDarkerColorColor:ToHSV()
    return Color3.fromHSV(getDarkerColorH, getDarkerColorS, getDarkerColorV / 2)
end

function library:GetSwatchBorder(getSwatchBorderColor: Color3): Color3
    if typeof(getSwatchBorderColor) ~= "Color3" then
        return Color3.fromRGB(190, 190, 190)
    end
    local getSwatchBorderBrightness = (getSwatchBorderColor.R + getSwatchBorderColor.G + getSwatchBorderColor.B) / 3
    if getSwatchBorderBrightness < 0.35 then
        return Color3.fromRGB(190, 190, 190)
    end
    return library:GetDarkerColor(getSwatchBorderColor)
end

function library:GetKeyString(getKeyStringKeyCode: Enum.KeyCode)
    if getKeyStringKeyCode.EnumType == Enum.KeyCode and getKeyStringKeyCode.Value > 33 and getKeyStringKeyCode.Value < 127 then
