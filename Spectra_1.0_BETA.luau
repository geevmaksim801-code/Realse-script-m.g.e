function library:PlayTabAnimation(playTabAnimationTab, playTabAnimationShowing: boolean, playTabAnimationOnComplete: (() -> ())?)
    if type(playTabAnimationTab) ~= "table" or not playTabAnimationTab.Container then
        if playTabAnimationOnComplete then
            playTabAnimationOnComplete()
        end

        return
    end

    local playTabAnimationTabContainer = playTabAnimationTab.Container :: Frame
    local playTabAnimationExisting = libraryActiveTabTweens[playTabAnimationTabContainer]
    if playTabAnimationExisting then
        libraryStopTween(playTabAnimationExisting, true)
        libraryActiveTabTweens[playTabAnimationTabContainer] = nil
    end

    local playTabAnimationBaseZIndex = playTabAnimationTabContainer.ZIndex
    if not (library.Animations and library.Animations.TabSwitch) then
        playTabAnimationTabContainer.Visible = playTabAnimationShowing
        playTabAnimationTabContainer.Position = UDim2.fromScale(0, 0)
        playTabAnimationTabContainer.ZIndex = playTabAnimationBaseZIndex

        if playTabAnimationOnComplete then
            playTabAnimationOnComplete()
        end

        return
    end

    if playTabAnimationShowing then
        local playTabAnimationTweenInfo = library.TabTransitionInfo or TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local playTabAnimationOffset = library.TabSwipeOffset or 26
        local playTabAnimationSwipeFrom = string.lower(library.TabSwipeFrom or "bottom")
        local playTabAnimationStartPosition
        local playTabAnimationStartingPositions = {
            Left = UDim2.fromOffset(-playTabAnimationOffset, 0),
            Right = UDim2.fromOffset(playTabAnimationOffset, 0),
            Top = UDim2.fromOffset(0, -playTabAnimationOffset),
            Bottom = UDim2.fromOffset(0, playTabAnimationOffset),
        }

        if playTabAnimationSwipeFrom == "auto" and library.PreviousTab then
            local playTabAnimationCurrentOrder = playTabAnimationTab.Button.LayoutOrder
            local playTabAnimationPreviousOrder = library.PreviousTab.Button.LayoutOrder
            if playTabAnimationCurrentOrder and playTabAnimationPreviousOrder then 
                playTabAnimationStartPosition = playTabAnimationCurrentOrder > playTabAnimationPreviousOrder and playTabAnimationStartingPositions.Top or playTabAnimationStartingPositions.Bottom 
            else
                playTabAnimationStartPosition = playTabAnimationStartingPositions.Bottom
            end
        elseif playTabAnimationSwipeFrom == "left" then
            playTabAnimationStartPosition = playTabAnimationStartingPositions.Left
        elseif playTabAnimationSwipeFrom == "top" then
            playTabAnimationStartPosition = playTabAnimationStartingPositions.Top
        elseif playTabAnimationSwipeFrom == "right" then
            playTabAnimationStartPosition = playTabAnimationStartingPositions.Right
        else 
            playTabAnimationStartPosition = playTabAnimationStartingPositions.Bottom
        end

        playTabAnimationTabContainer.ZIndex = playTabAnimationBaseZIndex + 1
        playTabAnimationTabContainer.Position = playTabAnimationStartPosition
        playTabAnimationTabContainer.Visible = true

        local playTabAnimationTween = libraryTweenService:Create(playTabAnimationTabContainer, playTabAnimationTweenInfo, {
            Position = UDim2.fromScale(0, 0)
        })

        libraryActiveTabTweens[playTabAnimationTabContainer] = playTabAnimationTween
        playTabAnimationTween:Play()

        local playTabAnimationConnection; playTabAnimationConnection = playTabAnimationTween.Completed:Connect(function(playTabAnimationPlaybackState)
            if playTabAnimationConnection then
                playTabAnimationConnection:Disconnect()
            end

            if libraryActiveTabTweens[playTabAnimationTabContainer] == playTabAnimationTween then
                libraryActiveTabTweens[playTabAnimationTabContainer] = nil
            end

            if playTabAnimationPlaybackState == Enum.PlaybackState.Cancelled then
                return
            end

            playTabAnimationTabContainer.ZIndex = playTabAnimationBaseZIndex
            if playTabAnimationOnComplete then
                playTabAnimationOnComplete()
            end
        end)
    else
        playTabAnimationTabContainer.Visible = false
        playTabAnimationTabContainer.Position = UDim2.fromScale(0, 0)
        playTabAnimationTabContainer.ZIndex = playTabAnimationBaseZIndex

        if playTabAnimationOnComplete then
            playTabAnimationOnComplete()
        end
    end
end

