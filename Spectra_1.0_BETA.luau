function themeManager:GetContrastReport(): { Ratio: number, PairName: string, Passes: boolean }
    local getContrastReportLibrary = themeManager.Library
    local getContrastReportFontColorOption = getContrastReportLibrary.Options.FontColor
    local getContrastReportBackgroundColorOption = getContrastReportLibrary.Options.BackgroundColor
    local getContrastReportMainColorOption = getContrastReportLibrary.Options.MainColor

    if not (getContrastReportFontColorOption and getContrastReportBackgroundColorOption and getContrastReportMainColorOption) then
        return { Ratio = math.huge, PairName = "", Passes = true }
    end

    local getContrastReportFontColor = getContrastReportFontColorOption.Value
    local getContrastReportSurfaces = {
        { Name = "font color vs. background color", Color = getContrastReportBackgroundColorOption.Value },
        { Name = "font color vs. main color", Color = getContrastReportMainColorOption.Value },
    }

    local getContrastReportWorstRatio, getContrastReportWorstName = math.huge, ""
    for _getContrastReportUnused1, getContrastReportSurface in getContrastReportSurfaces do
        local getContrastReportRatio = themeManagerGetContrastRatio(getContrastReportFontColor, getContrastReportSurface.Color)
        if getContrastReportRatio < getContrastReportWorstRatio then
            getContrastReportWorstRatio = getContrastReportRatio
            getContrastReportWorstName = getContrastReportSurface.Name
        end
    end

    return {
        Ratio = getContrastReportWorstRatio,
        PairName = getContrastReportWorstName,
        Passes = getContrastReportWorstRatio >= themeManagerContrastWarnThreshold,
    }
end

function themeManager:UpdateContrastWarning()
    local updateContrastWarningContrastLabel = themeManager.ContrastLabel
    if not updateContrastWarningContrastLabel or updateContrastWarningContrastLabel.Destroyed then
        return
    end

    local updateContrastWarningLibrary = themeManager.Library
    local updateContrastWarningReport = themeManager:GetContrastReport()
    local updateContrastWarningTextLabel = updateContrastWarningContrastLabel.TextLabel

    if not updateContrastWarningLibrary.Registry[updateContrastWarningTextLabel] then
        updateContrastWarningLibrary:AddToRegistry(updateContrastWarningTextLabel, {})
    end

    if updateContrastWarningReport.Passes then
        updateContrastWarningContrastLabel:SetText(string.format("Contrast check: good (%.1f:1)", updateContrastWarningReport.Ratio))

        updateContrastWarningTextLabel.TextColor3 = updateContrastWarningLibrary.Scheme.FontColor
        updateContrastWarningLibrary.Registry[updateContrastWarningTextLabel].TextColor3 = "FontColor"
    else
        updateContrastWarningContrastLabel:SetText(string.format(
            "Low contrast (%.1f:1) between %s. Aim for at least %.1f:1 so text stays readable.",
            updateContrastWarningReport.Ratio, updateContrastWarningReport.PairName, themeManagerContrastWarnThreshold
        ))

        updateContrastWarningTextLabel.TextColor3 = updateContrastWarningLibrary.Scheme.RedColor
        updateContrastWarningLibrary.Registry[updateContrastWarningTextLabel].TextColor3 = "RedColor"

        if not themeManager.ContrastWasPoor then
            updateContrastWarningLibrary:Notify({
                Title = "Low contrast theme",
                Description = string.format(
                    "Your %s has a contrast ratio of %.1f:1, below the recommended %.1f:1. Text may be hard to read.",
                    updateContrastWarningReport.PairName, updateContrastWarningReport.Ratio, themeManagerContrastWarnThreshold
                ),
                Time = 10,
            })
        end
    end

    themeManager.ContrastWasPoor = not updateContrastWarningReport.Passes
end

function themeManager:ThemeUpdate()
    local themeUpdateLibrary = themeManager.Library

    for _themeUpdateUnused1, themeUpdateSchemeIndex in themeManagerSchemeIndexes do
        local themeUpdateElement = themeUpdateLibrary.Options[themeUpdateSchemeIndex]
        if not themeUpdateElement then continue end

        themeUpdateLibrary.Scheme[themeUpdateSchemeIndex] = themeUpdateElement.Value
