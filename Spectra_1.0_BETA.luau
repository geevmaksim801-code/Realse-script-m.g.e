local function libraryOnPlayerChange()
    if library.Unloaded then
        return
    end

    local onPlayerChangePlayerList, onPlayerChangeExcludedPlayerList = libraryGetPlayers(), libraryGetPlayers(true)
    for _onPlayerChangeUnused1, onPlayerChangeDropdown in libraryOptions do
        if onPlayerChangeDropdown.Type == "Dropdown" and onPlayerChangeDropdown.SpecialType == "Player" then
            onPlayerChangeDropdown:SetValues(onPlayerChangeDropdown.ExcludeLocalPlayer and onPlayerChangeExcludedPlayerList or onPlayerChangePlayerList)
        end
    end
end

local function libraryOnTeamChange()
    if library.Unloaded then
        return
    end

    local onTeamChangeTeamList = libraryGetTeams()
    for _onTeamChangeUnused1, onTeamChangeDropdown in libraryOptions do
        if onTeamChangeDropdown.Type == "Dropdown" and onTeamChangeDropdown.SpecialType == "Team" then
            onTeamChangeDropdown:SetValues(onTeamChangeTeamList)
        end
    end
end

library:GiveSignal(libraryPlayers.PlayerAdded:Connect(libraryOnPlayerChange))
library:GiveSignal(libraryPlayers.PlayerRemoving:Connect(libraryOnPlayerChange))

library:GiveSignal(libraryTeams.ChildAdded:Connect(libraryOnTeamChange))
library:GiveSignal(libraryTeams.ChildRemoved:Connect(libraryOnTeamChange))

function library:Unload()
    library.Unloaded = true

    for unloadIndex = #library.Signals, 1, -1 do
        local unloadConnection = table.remove(library.Signals, unloadIndex)

        if unloadConnection and unloadConnection.Connected then
            unloadConnection:Disconnect()
        end
    end

    for _unloadUnused1 = 1, #library.UnloadSignals do
        local unloadCallback = table.remove(library.UnloadSignals, 1)

        if unloadCallback then
            library:SafeCallback(unloadCallback)
        end
    end

    for unloadIndex = #library.Tabs, 1, -1 do
        local unloadTab = table.remove(library.Tabs, unloadIndex)

        if unloadTab and unloadTab.Destroy then
            library:SafeCallback(unloadTab.Destroy, unloadTab)
        end
    end

    for unloadIndex = #libraryTooltips, 1, -1 do
        local unloadTooltip = table.remove(libraryTooltips, unloadIndex)

        if unloadTooltip and unloadTooltip.Destroy then
            library:SafeCallback(unloadTooltip.Destroy, unloadTooltip)
        end
    end

    if library.ActiveLoading then
        library.ActiveLoading:Destroy()
    end

    if libraryScreenGui then
        libraryScreenGui:Destroy()
    end

    table.clear(library.Registry)

    table.clear(libraryOptions)
    table.clear(libraryToggles)
    table.clear(libraryButtons)
    table.clear(libraryLabels)
    table.clear(libraryTooltips)

    table.clear(library.Tabs)
    table.clear(library.TabButtons)

    table.clear(library.Scales)
    table.clear(library.ScalesOffset)

    table.clear(library.Corners)
    table.clear(library.SpecificCorners)
    table.clear(library.ContextMenus)

    table.clear(library.Notifications)
    table.clear(library.Dialogues)
    table.clear(library.DraggableElements)
    table.clear(library.KeybindToggles)
    table.clear(library.DependencyBoxes)

    table.clear(libraryTransparencyCache)
    table.clear(libraryActiveTabTweens)

    library.Toggle = function(...) end
    library.ScreenGui = nil
    library.Floats = nil
    library.Overlay = nil
    library.WindowContainer = nil
    library.KeybindFrame = nil
    library.KeybindContainer = nil

    libraryGetgenv().Library = nil
end

libraryGetgenv().Library = library
return library

