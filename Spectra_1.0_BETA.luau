local function libraryGetSchemeValue(getSchemeValueIndex)
    if not getSchemeValueIndex then
        return nil
    end

    local getSchemeValueReplaceAliasIndex = librarySchemeReplaceAlias[getSchemeValueIndex]
    if getSchemeValueReplaceAliasIndex and library.Scheme[getSchemeValueReplaceAliasIndex] ~= nil then
        library.Scheme[getSchemeValueIndex] = library.Scheme[getSchemeValueReplaceAliasIndex]
        library.Scheme[getSchemeValueReplaceAliasIndex] = nil

        return library.Scheme[getSchemeValueIndex]
    end

    local getSchemeValueAliasIndex = librarySchemeAlias[getSchemeValueIndex]
    if getSchemeValueAliasIndex and library.Scheme[getSchemeValueAliasIndex] ~= nil then
        warn(string.format("Scheme Value %q is deprecated, please use %q instead.", getSchemeValueIndex, getSchemeValueAliasIndex))
        return library.Scheme[getSchemeValueAliasIndex]
    end

    return library.Scheme[getSchemeValueIndex]
end

local function libraryWaitForEvent(waitForEventEvent, waitForEventTimeout, waitForEventCondition)
    local waitForEventBindable = Instance.new("BindableEvent")
    local waitForEventConnection = waitForEventEvent:Once(function(...)
        if not waitForEventCondition or typeof(waitForEventCondition) == "function" and waitForEventCondition(...) then
            waitForEventBindable:Fire(true)
        else
            waitForEventBindable:Fire(false)
        end
    end)
    task.delay(waitForEventTimeout, function()
        waitForEventConnection:Disconnect()
        waitForEventBindable:Fire(false)
    end)

    local waitForEventResult = waitForEventBindable.Event:Wait()
    waitForEventBindable:Destroy()

    return waitForEventResult
end

