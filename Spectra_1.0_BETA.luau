    local isInsideFrameFrameSize = isInsideFrameParentFrame.AbsoluteSize

    return isInsideFrameGuiPos.X >= isInsideFrameFramePos.X
        and isInsideFrameGuiPos.X + isInsideFrameGuiSize.X <= isInsideFrameFramePos.X + isInsideFrameFrameSize.X
        and isInsideFrameGuiPos.Y >= isInsideFrameFramePos.Y
        and isInsideFrameGuiPos.Y + isInsideFrameGuiSize.Y <= isInsideFrameFramePos.Y + isInsideFrameFrameSize.Y
end

function library:SafeCallback(safeCallbackFunc: (...any) -> ...any, ...: any)
    if not (safeCallbackFunc and typeof(safeCallbackFunc) == "function") then
        return
    end

    local safeCallbackResult = table.pack(xpcall(safeCallbackFunc, function(safeCallbackError)
        task.defer(error, debug.traceback(safeCallbackError, 2))
        if library.NotifyOnError and library.Notify then
            library:Notify(safeCallbackError)
        end

        return safeCallbackError
    end, ...))

    if not safeCallbackResult[1] then
        return nil
    end

    return table.unpack(safeCallbackResult, 2, safeCallbackResult.n)
end

function GetOverlappingDraggable(libraryUI: GuiObject, libraryTargetPos: Vector2?)
    local libraryPos1 = libraryTargetPos or libraryUI.AbsolutePosition
    local librarySize1 = libraryUI.AbsoluteSize

    for _libraryUnused2, libraryOther in ipairs(library.DraggableElements) do
        if libraryOther == libraryUI or not libraryOther.Visible or not libraryOther.Parent then
            continue
        end

        local libraryPos2 = libraryOther.AbsolutePosition
        local librarySize2 = libraryOther.AbsoluteSize

        if libraryPos1.X < libraryPos2.X + librarySize2.X and
            libraryPos1.X + librarySize1.X > libraryPos2.X and
            libraryPos1.Y < libraryPos2.Y + librarySize2.Y and
            libraryPos1.Y + librarySize1.Y > libraryPos2.Y then
            return libraryOther
        end
    end

    return nil
end

function GetNonOverlappingPosition(libraryUI: GuiObject, libraryStartPos: UDim2?)
    local libraryScreenSize = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)) - Vector2.new(100, 100)
    local libraryStart = libraryStartPos and Vector2.new(libraryStartPos.X.Offset, libraryStartPos.Y.Offset) or Vector2.new(6, 6)
    local libraryPadding = 6

    local libraryCurrentX = libraryStart.X
    local libraryCurrentY = libraryStart.Y

    local librarySize = libraryUI.AbsoluteSize
    if librarySize.X == 0 and librarySize.Y == 0 then
        libraryRunService.RenderStepped:Wait()
        librarySize = libraryUI.AbsoluteSize
    end

    if librarySize.X == 0 then librarySize = Vector2.new(150, 40) end

    local libraryMaxXInColumn = librarySize.X

    while true do
        local libraryObstacle = GetOverlappingDraggable(libraryUI, Vector2.new(libraryCurrentX, libraryCurrentY))
        if not libraryObstacle then
            break
        end

        if libraryObstacle.AbsoluteSize.X > libraryMaxXInColumn then
            libraryMaxXInColumn = libraryObstacle.AbsoluteSize.X
        end

        local libraryNextY = libraryObstacle.AbsolutePosition.Y + libraryObstacle.AbsoluteSize.Y + libraryPadding
        if libraryNextY + librarySize.Y > libraryScreenSize.Y - libraryPadding then
            local libraryNextX = libraryCurrentX + libraryMaxXInColumn + libraryPadding

            if libraryNextX + librarySize.X > libraryScreenSize.X - libraryPadding then
                break
            end

            libraryCurrentY = libraryStart.Y
            libraryCurrentX = libraryNextX
            libraryMaxXInColumn = librarySize.X
        else
            libraryCurrentY = libraryNextY
        end
    end

    return UDim2.fromOffset(libraryCurrentX, libraryCurrentY)
end

function PositionDraggable(libraryUI: GuiObject, libraryStartPos: UDim2?)
    libraryUI.Position = GetNonOverlappingPosition(libraryUI, libraryStartPos)
end

