    local getCustomThemeSuccessDecode, getCustomThemeDecoded = pcall(themeManagerHttpService.JSONDecode, themeManagerHttpService, getCustomThemeContent)
    if not getCustomThemeSuccessDecode or typeof(getCustomThemeDecoded) ~= "table" then
        return nil
    end

    return getCustomThemeDecoded
end

